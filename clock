from datetime import datetime
import sys
import time
from zoneinfo import ZoneInfo

JST = ZoneInfo("Asia/Tokyo")

if len(sys.argv) > 1:
    print("error: no arguments allowed", file=sys.stderr)
    sys.exit(1)

while True:
    now_jst = datetime.now(JST)
    print(now_jst.strftime("%Y-%m-%d %H:%M:%S"), flush=True)
    time.sleep(1)
